<html>
  <head></head>
  <body>
    <h1><%= title%></h1>
    <div>
      <div><a href="/new">Link to new</a></div>
    </div>
    <% messages.forEach((message) => {%>
        <ul>
            <li>user: <%=message.username%></li>
            <li>text: <%= message.text%></li>
            <li>added: <%= message.added%></li>
            <li><a href='/details/<%= message.username%>'>details</a></li>
        </ul>
    <%})%>
  </body>
</html>
